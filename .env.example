# ---- olmOCR / vLLM -----------------------------------------------------------
# FP8 needs compute capability >= 8.9 (L40S, RTX 4090, H100, B200).
# Ampere — A100 (8.0), RTX 3090/A6000 (8.6) — has NO FP8 tensor cores: use the
# bf16 repo below instead, which needs ~16 GB of VRAM for weights alone.
# Run `docfusion preflight` to have this chosen for you.
OLMOCR_MODEL=allenai/olmOCR-2-7B-1025-FP8
# OLMOCR_MODEL=allenai/olmOCR-2-7B-1025          # bf16 — Ampere and older

# PINNED ON PURPOSE. `latest` is a moving target that has broken this stack
# before: 0.26 removed --disable-log-requests outright, and its UvaBuffer path
# aborts wherever pinned memory is unavailable (notably WSL2). 0.11.2 is the
# version olmOCR itself pins. Bump deliberately, with a benchmark run after.
VLLM_VERSION=v0.11.2
VLLM_PORT=8000
VLLM_GPU_COUNT=1
VLLM_GPU_MEM_UTIL=0.90
VLLM_MAX_NUM_SEQS=256
# Cap deliberately: page images eat context; oversized KV cache = OOM crashes.
VLLM_MAX_MODEL_LEN=16384
# Only needed if your network requires an authenticated HF pull (weights are public).
HUGGING_FACE_HUB_TOKEN=

# ---- docfusion ---------------------------------------------------------------
# watch = poll /data/in continuously; batch = one pass then exit
DOCFUSION_MODE=watch
DOCFUSION_WATCH_INTERVAL=30
# Concurrent in-flight Tier-2 page requests. vLLM batches continuously, so a
# serial client leaves most of the GPU idle. Keep at or below VLLM_MAX_NUM_SEQS.
DOCFUSION_WORKERS=8
# 1 = skip Docling Tier-1 (text-layer fallback only, smaller image)
WITH_DOCLING=1
DOCFUSION_NO_DOCLING=0
INPUT_DIR=./data/in
OUTPUT_DIR=./data/out
